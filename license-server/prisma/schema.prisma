// Prisma schema for Server-Centric License System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LicensePlan {
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
  CUSTOM
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  DISABLED
  REVOKED
}

enum ActionType {
  ACTIVATION_SUCCESS
  ACTIVATION_FAILED
  VALIDATION_SUCCESS
  VALIDATION_FAILED
  HEARTBEAT_SUCCESS
  HEARTBEAT_FAILED
  EXPIRED_ATTEMPT
  REVOKED_ATTEMPT
  DISABLED_ATTEMPT
  DEACTIVATED
  DEVICE_RESET
  CONFIG_CHANGE
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

model License {
  id             String        @id @default(uuid())
  key            String        @unique
  plan           LicensePlan   @default(YEARLY)
  status         LicenseStatus @default(ACTIVE)
  maxDevices     Int           @default(1)
  expiresAt      DateTime?
  customerEmail  String?
  customerNotes  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  devices        Device[]
  activityLogs   ActivityLog[]

  @@index([key])
  @@index([status])
  @@index([customerEmail])
}

model Device {
  id               String   @id @default(uuid())
  licenseId        String
  deviceId         String   // Persistent UUID generated by client extension
  metadata         String?  // JSON string containing browser, OS, etc.
  extensionVersion String?
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  license          License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  activityLogs     ActivityLog[]

  @@unique([licenseId, deviceId])
  @@index([deviceId])
}

model ActivityLog {
  id         String     @id @default(uuid())
  licenseId  String?
  deviceId   String?
  action     ActionType
  ipAddress  String?
  userAgent  String?
  details    String?    // JSON string for metadata / contextual errors
  createdAt  DateTime   @default(now())

  license    License?   @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  device     Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
}

model AdminUser {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  role              AdminRole @default(ADMIN)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  auditLogs         AuditLog[]

  @@index([email])
}

model AuditLog {
  id         String    @id @default(uuid())
  adminId    String?
  action     String
  targetType String?
  targetId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Configuration {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
